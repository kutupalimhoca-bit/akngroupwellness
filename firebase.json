{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs18"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/payments/vpos/initiate",
        "function": "initiateVpos"
      },
      {
        "source": "/api/v1/payments/vpos/callback",
        "function": "vposCallback"
      },
      {
        "source": "/api/v1/compliance/contract-approvals",
        "function": "recordContractApprovals"
      },
      {
        "source": "/api/v1/integrations/order-commission",
        "function": "handleOrderCommission"
      },
      {
        "source": "/api/v1/documents",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/documents/**",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/admin/documents",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/admin/login",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/member/session",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
