{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs18"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/v1/payments/regional-prices",
        "function": {
          "functionId": "regionalPackagePrices",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/payments/vpos/initiate",
        "function": {
          "functionId": "initiateVpos",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/payments/vpos/callback",
        "function": {
          "functionId": "vposCallback",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/compliance/contract-approvals",
        "function": {
          "functionId": "recordContractApprovals",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/integrations/order-commission",
        "function": {
          "functionId": "handleOrderCommission",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/documents",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/documents/**",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/admin/documents",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/admin/login",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "/api/v1/member/session",
        "function": {
          "functionId": "sharedDocuments",
          "region": "europe-west1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
