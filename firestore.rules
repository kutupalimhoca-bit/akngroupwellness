rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Kullanıcı Dokümanı: Herkes kendi profilini okuyabilir, kimse doğrudan bakiyesini değiştiremez
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.role == 'admin');
      allow write: if false; // Sadece Cloud Functions yazabilir
    }

    // Cüzdanlar ve Komisyon Logları: Yalnızca sahibi okuyabilir, istemci asla yazamaz
    match /wallets/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Sadece Cloud Functions yazabilir
    }

    match /commission_logs/{logId} {
      allow read: if request.auth != null && (resource.data.target_user_id == request.auth.uid || resource.data.source_user_id == request.auth.uid);
      allow write: if false;
    }

    // Paketler ve Ürün Kataloğu: Tüm giriş yapmış kullanıcılar okuyabilir
    match /packages/{packageId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /user_contract_approvals/{approvalId} {
      allow read, write: if false;
    }

    // Sipariş Logları: Sadece ilgili kullanıcı okuyabilir
    match /orders_log/{orderId} {
      allow read: if request.auth != null && (resource.data.user_id == request.auth.uid || request.auth.token.role == 'admin');
      allow write: if false;
    }
  }
}
